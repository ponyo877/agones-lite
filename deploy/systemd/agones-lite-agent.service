# Agent for a further machine that runs game servers.
# Install the binary as /usr/local/bin/agones-lite, then:
#   systemctl enable --now agones-lite-agent
[Unit]
Description=agones-lite agent
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
ExecStart=/usr/local/bin/agones-lite agent --config /etc/agones-lite/agent.yaml
Restart=always
RestartSec=2
KillMode=process

[Install]
WantedBy=multi-user.target
