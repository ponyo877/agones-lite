# Control plane, with an agent for game servers on the same machine.
# Install the binary as /usr/local/bin/agones-lite, then:
#   systemctl enable --now agones-lite
[Unit]
Description=agones-lite control plane
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
ExecStart=/usr/local/bin/agones-lite server --config /etc/agones-lite/server.yaml
Restart=always
RestartSec=2
# Stopping or restarting this service must not stop the game servers: they
# are Docker containers and keep running until the service is back.
KillMode=process

[Install]
WantedBy=multi-user.target
