# Control plane, with an agent for game servers on the same machine.
# Install the binary as /usr/local/bin/scrim, then:
#   systemctl enable --now scrim
[Unit]
Description=scrim control plane
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
ExecStart=/usr/local/bin/scrim server --config /etc/scrim/server.yaml
Restart=always
RestartSec=2
# Stopping or restarting this service must not stop the game servers: they
# are Docker containers and keep running until the service is back.
KillMode=process

[Install]
WantedBy=multi-user.target
